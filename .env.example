# ============================================================================
#  Aisuluu Tourbot — environment configuration
#  Copy to .env for local dev. On Railway, set these as service variables.
# ============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public URL of THIS backend (bot). Used to auto-register the WAHA webhook.
# On Railway this is your bot service's public domain, e.g. https://tourbot.up.railway.app
PUBLIC_URL=

# --- AI provider ------------------------------------------------------------
# Gemini is PREFERRED when GEMINI_API_KEY is set; Claude is the fallback.
# Both share the same prompt, tools and stored history — switching providers
# keeps every existing conversation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Fallback: Claude (Anthropic). Options: claude-sonnet-5 (balanced),
# claude-opus-4-8 (smartest), claude-haiku-4-5-20251001 (cheapest/fastest).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Max output tokens per turn (any provider).
CLAUDE_MAX_TOKENS=1024
# Set to true to disable AI replies (bot goes silent / manual mode).
DISABLE_AI=false

# --- Tourvisor (tourvisor.ru API) -------------------------------------------
# Request API access at tourvisor.ru — you receive a login + password.
TOURVISOR_BASE_URL=https://tourvisor.ru/xml
TOURVISOR_AUTH_LOGIN=
TOURVISOR_AUTH_PASS=
# Default departure city id (from list.php?type=departure). e.g. 1=Москва.
TOURVISOR_DEFAULT_DEPARTURE=
# Search currency: 0=RUB, 1=USD/EUR, 2=BYN, 3=KZT.
TOURVISOR_CURRENCY=0

# --- WAHA (WhatsApp HTTP API) -----------------------------------------------
# On Railway, point this at the WAHA service's INTERNAL url,
# e.g. http://waha.railway.internal:3000  (private networking, no egress cost).
# Locally with docker-compose: http://waha:3000
WAHA_BASE_URL=http://localhost:3000
# Must match WHATSAPP_API_KEY set on the WAHA service.
WAHA_API_KEY=
# The OWNER company's WAHA session. Extra tour companies are created from the
# Telegram admin bot (/newco) and get their own sessions (company-<id>);
# requires DATABASE_URL and WAHA >= 2026.6.1 (multi-session).
WAHA_SESSION=default
# Optional shared secret appended to the webhook path (/webhooks/waha/<secret>).
WAHA_WEBHOOK_SECRET=
# true → bot registers its own webhook on WAHA at startup (needs PUBLIC_URL).
# Leave false when WAHA has its own WHATSAPP_HOOK_URL (recommended on Railway).
WAHA_AUTOREGISTER=false

# --- Telegram (admin alerts) ------------------------------------------------
# Create a bot via @BotFather -> token. Get your chat id via @userinfobot
# (or a group chat id — add the bot to the group).
# Multiple admins: list chat ids comma-separated, e.g. 111,222,333.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Telegram demo bot (optional) -------------------------------------------
# A SECOND bot token: anyone can chat with the AI tour assistant in Telegram —
# handy for demoing the product to prospective agencies. Leads/escalations from
# demo chats show up in the ADMIN bot labeled with DEMO_COMPANY_NAME.
TELEGRAM_DEMO_BOT_TOKEN=
DEMO_COMPANY_NAME=Демо Тревел

# --- Business / handoff -----------------------------------------------------
# Name of the OWNER company (bound to WAHA_SESSION). Other companies' names
# live in the database (managed via /newco in the Telegram admin bot).
COMPANY_NAME=Aisuluu Travel
MANAGER_NAME=Айсулуу
# Manager WhatsApp in international format WITHOUT + (for wa.me links).
MANAGER_WHATSAPP=996555123456

# Comma-separated phones/chatIds allowed to use the bot (empty = everyone).
ALLOWLIST=

# --- Persistence (optional) -------------------------------------------------
# Postgres connection string for durable conversation storage. Without it the
# bot keeps conversations in memory only (lost on restart). docker-compose sets
# this automatically; on Railway, add a Postgres service and reference its
# DATABASE_URL. Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=
